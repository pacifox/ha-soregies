# Copiez ce fichier en renew_token.env, remplissez-le, puis avant de lancer
# renew_token.py : set -a; source renew_token.env; set +a
#
# Ne commitez jamais le fichier rempli — renew_token.env est dans .gitignore.

# Identifiants du portail client (mon-espace-client.soregies.fr)
SOREGIES_EMAIL=vous@exemple.fr
SOREGIES_PASSWORD=changez-moi

# Adresse de votre Home Assistant, jointe depuis l'endroit où tourne ce script
HA_URL=http://localhost:8123

# Profil Home Assistant → Sécurité → Jetons d'accès à long terme → Créer un jeton
HA_LONG_LIVED_TOKEN=

# Repli pour l'intégration 1.0.0 uniquement (inutile à partir de 1.0.1) :
# dossier .storage de Home Assistant. Le défaut convient à une exécution sur
# l'hôte HA lui-même (add-on Terminal & SSH, installation Docker/venv locale).
HA_STORAGE_DIR=/config/.storage
